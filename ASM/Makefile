# **************************************************************************** #
#                                   PROGRAM                                    #
# **************************************************************************** #

NAME = Colleen Grace Sully

# **************************************************************************** #
#                                     VARS                                     #
# **************************************************************************** #

MKDIR = mkdir -p
RM = rm -rf

# **************************************************************************** #
#                                   COMPILER                                   #
# **************************************************************************** #

AS = nasm
ASFLAGS = -f elf64

LD = gcc

# **************************************************************************** #
#                                     DIRS                                     #
# **************************************************************************** #

OBJ_DIR = build

# **************************************************************************** #
#                                   SOURCES                                    #
# **************************************************************************** #

SRC = $(NAME:%=%.s)

OBJ = $(NAME:%=$(OBJ_DIR)/%.o)

# files written by Grace and Sully at runtime
GEN = Grace_kid.s Sully_*

# **************************************************************************** #
#                                    RULES                                     #
# **************************************************************************** #

PHONY := all
all: $(NAME)

$(NAME): %: $(OBJ_DIR)/%.o
	$(LD) -o $@ $<

$(OBJ_DIR)/%.o: %.s | $(OBJ_DIR)
	$(AS) $(ASFLAGS) -o $@ $<

$(OBJ_DIR):
	$(MKDIR) $(OBJ_DIR)

PHONY += clean
clean:
	$(RM) $(OBJ_DIR)

PHONY += fclean
fclean: clean
	$(RM) $(NAME) $(GEN)

PHONY += re
re:: fclean
re:: all

.PHONY: $(PHONY)

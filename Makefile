# **************************************************************************** #
#                                     DIRS                                     #
# **************************************************************************** #

DIRS = C ASM

# **************************************************************************** #
#                                    RULES                                     #
# **************************************************************************** #

PHONY := all clean fclean re
all clean fclean re:
	for dir in $(DIRS); do $(MAKE) -C $$dir $@ || exit 1; done

.PHONY: $(PHONY)
